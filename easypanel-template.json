{
  "services": [
    {
      "type": "app",
      "data": {
        "serviceName": "wordpress",
        "env": "WORDPRESS_DB_HOST=$(PROJECT_NAME)_wordpress-db\nWORDPRESS_DB_USER=mariadb\nWORDPRESS_DB_PASSWORD=5f6ryv1xqikaiamxr1gq\nWORDPRESS_DB_NAME=$(PROJECT_NAME)",
        "source": {
          "type": "github",
          "owner": "adikiss",
          "repo": "wordpress-frankenphp",
